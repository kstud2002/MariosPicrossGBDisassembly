; GameState 00 Phase pointer table entries (accessed via RST_18 dispatcher):
; Offset calculation: Phase_value * 2, added to return address $4f91 yields pointer location
; Phase $00: $00 * 2 = $00 bytes -> pointer at $4f91 + $00 = $4f91
03:4f91 GS00_PhasePointer_00
