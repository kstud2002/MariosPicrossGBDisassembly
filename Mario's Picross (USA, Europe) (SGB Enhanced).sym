; GameState 00 Phase pointer table entries (accessed via RST_18 dispatcher):
; Offset calculation: Phase_value * 2, added to return address $4f8b yields pointer location
; Phase $00: $00 * 2 = $00 bytes -> pointer at $4f8b + $00 = $4f8b
03:4f8b GS00_PhasePointer_00
03:4f8b .data:2
; Phase $01: $01 * 2 = $02 bytes -> pointer at $4f8b + $02 = $4f8d
03:4f8d GS00_PhasePointer_01
03:4f8d .data:2
; Phase $02: $02 * 2 = $04 bytes -> pointer at $4f8b + $04 = $4f8f
03:4f8f GS00_PhasePointer_02
03:4f8f .data:2
; Phase $03: $03 * 2 = $06 bytes -> pointer at $4f8b + $06 = $4f91
03:4f91 GS00_PhasePointer_03
03:4f91 .data:2
; Phase $04: $04 * 2 = $08 bytes -> pointer at $4f8b + $08 = $4f93
03:4f93 GS00_PhasePointer_04
03:4f93 .data:2

